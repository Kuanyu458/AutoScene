{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/jobs/openmontage_video",
  "title": "OpenMontage Video Job",
  "description": "Canonical job contract consumed by the openmontage-video skill.",
  "type": "object",
  "required": ["version", "project_id", "source", "recording", "music", "features", "edit", "approvals", "output"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "source": {
      "type": "object",
      "required": ["mode", "media"],
      "properties": {
        "mode": { "type": "string", "enum": ["provided", "record", "mixed"] },
        "media": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "media_type": { "type": "string", "enum": ["video", "image", "audio", "recordly_export", "other"] },
              "role": { "type": "string" },
              "rights": { "type": "string" },
              "privacy": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "recording": {
      "type": "object",
      "required": ["base_url", "allowed_origins", "flows"],
      "properties": {
        "base_url": { "type": "string", "format": "uri" },
        "allowed_origins": {
          "type": "array",
          "items": { "type": "string", "format": "uri-reference" }
        },
        "flows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "steps"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["op"],
                  "properties": {
                    "op": { "type": "string", "enum": ["goto", "click", "fill", "select", "press", "scroll", "wait", "assert", "hold", "screenshot"] },
                    "url": { "type": "string" },
                    "selector": { "type": "string" },
                    "value": { "type": ["string", "number", "boolean"] },
                    "text": { "type": "string" },
                    "seconds": { "type": "number", "minimum": 0, "maximum": 300 },
                    "x": { "type": "number" },
                    "y": { "type": "number" },
                    "amount": { "type": "number" },
                    "key": { "type": "string" },
                    "path": { "type": "string" },
                    "expected": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "music": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["provided", "library", "search", "generate"] },
        "path": { "type": ["string", "null"] },
        "source_url": { "type": ["string", "null"] },
        "rights": { "type": "string" }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "required": ["beat_sync", "ui_3d", "ui_capture"],
      "properties": {
        "beat_sync": { "type": "string", "enum": ["required", "off"] },
        "ui_3d": { "type": "string", "enum": ["required", "off"] },
        "ui_capture": { "type": "string", "enum": ["required", "off"] }
      },
      "additionalProperties": false
    },
    "edit": {
      "type": "object",
      "required": ["snap_tolerance_ms", "focus_budget_per_scene", "focus_scale"],
      "properties": {
        "snap_tolerance_ms": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "focus_budget_per_scene": { "type": "integer", "minimum": 0, "maximum": 3 },
        "focus_scale": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "number", "minimum": 1, "maximum": 2 }
        }
      },
      "additionalProperties": false
    },
    "approvals": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "type": "string", "enum": ["guided", "autonomous"] }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["resolution", "fps", "language"],
      "properties": {
        "resolution": { "type": "string", "pattern": "^[1-9][0-9]{2,4}x[1-9][0-9]{2,4}$" },
        "fps": { "type": "integer", "minimum": 1, "maximum": 120 },
        "language": { "type": "string", "minLength": 2 }
      },
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "subject", "decision"],
        "properties": {
          "category": { "type": "string" },
          "subject": { "type": "string" },
          "decision": { "type": "string" },
          "timestamp": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "decision_log": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "subject", "decision"],
        "properties": {
          "category": { "type": "string" },
          "subject": { "type": "string" },
          "decision": { "type": "string" },
          "timestamp": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
