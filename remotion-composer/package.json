    "@remotion/player": "4.0.484",
    "@remotion/transitions": "4.0.484",
    "@remotion/three": "4.0.484",
    "@react-three/fiber": "8.18.0",
    "d3-geo": "^3.1.1",
    "fast-uri": "3.1.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "4.0.484",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "three": "0.155.0"
  },
  "devDependencies": {
    "@types/offscreencanvas": "2019.7.3",
